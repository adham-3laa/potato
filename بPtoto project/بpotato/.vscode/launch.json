{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Open Potato Restaurant",
            "url": "file:///${workspaceFolder}/frontend/index.html",
            "webRoot": "${workspaceFolder}/frontend",
            "runtimeArgs": [
                "--disable-web-security",
                "--user-data-dir=${workspaceFolder}/chrome-debug-profile"
            ],
            "sourceMaps": true,
            "trace": true
        }
    ]
}